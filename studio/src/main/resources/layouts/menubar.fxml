<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.CheckMenuItem?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<MenuBar xmlns:fx="http://javafx.com/fxml" fx:controller="io.github.trimax.venta.studio.controllers.MenuController" useSystemMenuBar="true">
    <Menu text="File">
        <MenuItem text="New Scene" disable="true"/>
        <MenuItem text="Open Project…" accelerator="Shortcut+O" onAction="#onProjectOpen"/>
        <Menu fx:id="menuRecent" text="Open Recent"/>
        <SeparatorMenuItem/>
        <MenuItem fx:id="menuSave" text="Save" accelerator="Shortcut+S" disable="true" onAction="#onSave"/>
        <MenuItem text="Save As…" accelerator="Shortcut+Shift+S" disable="true"/>
        <MenuItem text="Build Archive…" disable="true"/>
        <SeparatorMenuItem/>
        <MenuItem text="Quit" accelerator="Shortcut+Q" onAction="#onQuit"/>
    </Menu>
    <Menu text="Edit">
        <MenuItem fx:id="menuUndo" text="Undo" accelerator="Shortcut+Z" disable="true" onAction="#onUndo"/>
        <MenuItem fx:id="menuRedo" text="Redo" accelerator="Shortcut+Shift+Z" disable="true" onAction="#onRedo"/>
        <SeparatorMenuItem/>
        <MenuItem text="Cut" accelerator="Shortcut+X" disable="true"/>
        <MenuItem text="Copy" accelerator="Shortcut+C" disable="true"/>
        <MenuItem text="Paste" accelerator="Shortcut+V" disable="true"/>
        <MenuItem fx:id="menuDuplicate" text="Duplicate" accelerator="Shortcut+D" disable="true" onAction="#onDuplicate"/>
        <MenuItem fx:id="menuDelete" text="Delete" accelerator="Shortcut+BACK_SPACE" disable="true" onAction="#onDelete"/>
        <SeparatorMenuItem/>
        <MenuItem text="Select All" accelerator="Shortcut+A" disable="true"/>
    </Menu>
    <Menu text="Assets">
        <MenuItem text="Import…" disable="true"/>
        <Menu text="Create" disable="true">
            <MenuItem text="Material"/>
            <MenuItem text="Object"/>
            <MenuItem text="Scene"/>
        </Menu>
        <SeparatorMenuItem/>
        <MenuItem text="Refresh" accelerator="F5" onAction="#onRefresh"/>
    </Menu>
    <Menu fx:id="menuObject" text="Object" disable="true">
        <MenuItem text="Create Object…" userData="Object" onAction="#onCreate"/>
        <MenuItem text="Create Light…" userData="Light" onAction="#onCreate"/>
        <MenuItem text="Create Emitter…" userData="Emitter" onAction="#onCreate"/>
        <MenuItem text="Create Billboard…" userData="Billboard" onAction="#onCreate"/>
        <MenuItem text="Create Sound Source…" userData="Sound" onAction="#onCreate"/>
        <MenuItem text="Create Terrain…" userData="Terrain" onAction="#onCreate"/>
        <MenuItem text="Create Water…" userData="Water" onAction="#onCreate"/>
    </Menu>
    <Menu text="View">
        <CheckMenuItem fx:id="viewHierarchy" text="Hierarchy" selected="true" onAction="#onPanels"/>
        <CheckMenuItem fx:id="viewInspector" text="Inspector" selected="true" onAction="#onPanels"/>
        <CheckMenuItem fx:id="viewBottom" text="Project and Console" selected="true" onAction="#onPanels"/>
        <SeparatorMenuItem/>
        <Menu text="Camera">
            <MenuItem text="Perspective" onAction="#onViewPerspective"/>
            <MenuItem text="Top" onAction="#onViewTop"/>
            <MenuItem text="Front" onAction="#onViewFront"/>
            <MenuItem text="Side" onAction="#onViewSide"/>
        </Menu>
        <MenuItem text="Reset Camera" accelerator="Shortcut+R" onAction="#onViewReset"/>
        <SeparatorMenuItem/>
        <Menu fx:id="viewWireframe" text="Wireframe">
            <CheckMenuItem text="Objects" userData="Objects" onAction="#onWireframe"/>
            <CheckMenuItem text="Terrain" userData="Terrain" onAction="#onWireframe"/>
            <CheckMenuItem text="Water" userData="Water" onAction="#onWireframe"/>
            <CheckMenuItem text="Emitters" userData="Emitters" onAction="#onWireframe"/>
            <CheckMenuItem text="Billboards" userData="Billboards" onAction="#onWireframe"/>
            <SeparatorMenuItem/>
            <MenuItem text="All" onAction="#onWireframeAll"/>
            <MenuItem text="None" onAction="#onWireframeNone"/>
        </Menu>
        <CheckMenuItem fx:id="viewGrid" text="Grid" selected="true" onAction="#onOverlay"/>
        <CheckMenuItem fx:id="viewMarks" text="Marks of Lights and Sounds" selected="true" onAction="#onOverlay"/>
    </Menu>
    <Menu text="Tools">
        <MenuItem text="Heightmap Generator" disable="true"/>
        <MenuItem text="Texture Packer" disable="true"/>
        <MenuItem text="Texture Mixer" disable="true"/>
    </Menu>
    <Menu text="Help">
        <MenuItem text="About Venta Studio" onAction="#onAbout"/>
        <MenuItem text="Documentation" onAction="#onDocumentation"/>
        <MenuItem text="Open Log Folder" onAction="#onLogFolder"/>
    </Menu>
</MenuBar>
