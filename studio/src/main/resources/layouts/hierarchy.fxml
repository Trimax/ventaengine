<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="io.github.trimax.venta.studio.controllers.HierarchyController" styleClass="panel" minWidth="180">
    <Label text="Hierarchy" styleClass="panel-title"/>
    <TextField fx:id="filter" promptText="Search"/>
    <TreeView fx:id="tree" showRoot="true" VBox.vgrow="ALWAYS"/>
</VBox>
