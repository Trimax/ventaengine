<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="io.github.trimax.venta.studio.controllers.ProjectController">
    <HBox styleClass="tool-row" spacing="6">
        <TextField fx:id="filter" promptText="Search in the folder" HBox.hgrow="ALWAYS"/>
        <Button text="Refresh" onAction="#onRefresh"/>
    </HBox>
    <SplitPane dividerPositions="0.25" VBox.vgrow="ALWAYS">
        <TreeView fx:id="folders" showRoot="true"/>
        <ListView fx:id="files"/>
    </SplitPane>
</VBox>
